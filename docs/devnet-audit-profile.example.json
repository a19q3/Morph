{
  "schema": "morph.devnet_audit_profile",
  "description": "Audit profile schema is a devnet evidence taxonomy label. The current suffix does not denote the active protocol baseline; factory authorisation is interpreted through bounded WitnessEnvelope kind/body/digest envelopes on the current current-envelope implementation line.",
  "families": [
    {
      "id": "state_authority_authenticity",
      "severity": "P0",
      "principle": "Vault and watchtower state authority is an authentic Morph StateCell identity, not parseable StateHeader bytes.",
      "required_coverage_tags": [
        "state_authority_authenticity"
      ],
      "required_scenarios": [
        "bilateral_supersede_watchtower_finalise",
        "watchtower_operations"
      ],
      "required_committed_checks": [
        "supersede-smoke",
        "watch-auto-sponsor/finalise"
      ],
      "required_expected_failures": []
    },
    {
      "id": "canonical_relative_maturity",
      "severity": "P0",
      "principle": "Finalisation maturity is a canonical relative CKB since condition, not a raw integer threshold.",
      "required_coverage_tags": [
        "canonical_relative_maturity"
      ],
      "required_scenarios": [
        "bilateral_supersede_watchtower_finalise",
        "negative_attack_matrix"
      ],
      "required_committed_checks": [
        "supersede-smoke"
      ],
      "required_expected_failures": [
        {
          "check": "finalise-since-negative-smoke",
          "morph_error": "StateSinceNotMature",
          "error_code": 16
        }
      ]
    },
    {
      "id": "state_retirement_non_orphaning",
      "severity": "P0",
      "principle": "StateCell retirement cannot orphan channel or child-channel value.",
      "required_coverage_tags": [
        "state_retirement_non_orphaning"
      ],
      "required_scenarios": [
        "bilateral_direct_publish_finalise",
        "factory_lifecycle_matrix"
      ],
      "required_committed_checks": [
        "manual-channel/finalise",
        "factory/child-finalise"
      ],
      "required_expected_failures": []
    },
    {
      "id": "signed_descriptor_evolution",
      "severity": "P0",
      "principle": "Settlement descriptors may evolve only as part of a signed current state or factory transition.",
      "required_coverage_tags": [
        "signed_descriptor_evolution"
      ],
      "required_scenarios": [
        "splice_lifecycle_matrix",
        "factory_splice_then_exit"
      ],
      "required_committed_checks": [
        "splice-in-smoke",
        "xudt-splice-out-smoke",
        "factory-splice-in-smoke"
      ],
      "required_expected_failures": []
    },
    {
      "id": "non_interference_not_authorisation",
      "severity": "P0",
      "principle": "Merkle or non-interference evidence localises a change; it does not authorise value creation.",
      "required_coverage_tags": [
        "non_interference_not_authorisation"
      ],
      "required_scenarios": [
        "factory_lifecycle_matrix"
      ],
      "required_committed_checks": [
        "factory-reduced-rights-smoke",
        "factory-merkle-update-smoke"
      ],
      "required_expected_failures": []
    },
    {
      "id": "factory_value_delta_binding",
      "severity": "P0",
      "principle": "ReserveClaim, Balance, FactoryVault, and child-vault deltas must be exactly bound.",
      "required_coverage_tags": [
        "factory_value_delta_binding"
      ],
      "required_scenarios": [
        "factory_lifecycle_matrix",
        "factory_splice_then_exit",
        "negative_attack_matrix"
      ],
      "required_committed_checks": [
        "factory-reduced-exit-smoke",
        "factory-reduced-xudt-exit-smoke",
        "factory-splice-in-smoke"
      ],
      "required_expected_failures": [
        {
          "check": "factory-reduced-xudt-negative-exit-smoke",
          "morph_error": "SettlementOutputMismatch",
          "error_code": 28
        }
      ]
    },
    {
      "id": "typed_asset_binding",
      "severity": "P0",
      "principle": "xUDT type hash, token amount, child vault, FactoryVault typed change, and descriptor commitment must bind the same typed asset.",
      "required_coverage_tags": [
        "typed_asset_binding"
      ],
      "required_scenarios": [
        "splice_lifecycle_matrix",
        "factory_lifecycle_matrix",
        "negative_attack_matrix",
        "extreme_state_value_cases"
      ],
      "required_committed_checks": [
        "xudt-smoke",
        "xudt-splice-out-smoke",
        "factory-reduced-xudt-exit-smoke",
        "factory-xudt/smoke"
      ],
      "required_expected_failures": [
        {
          "check": "xudt-negative-smoke",
          "morph_error": "SettlementOutputMismatch",
          "error_code": 28
        },
        {
          "check": "factory-xudt-negative/smoke",
          "morph_error": "SettlementOutputMismatch",
          "error_code": 28
        },
        {
          "check": "factory-reduced-xudt-negative-exit-smoke",
          "morph_error": "SettlementOutputMismatch",
          "error_code": 28
        }
      ]
    },
    {
      "id": "sponsor_policy_boundary",
      "severity": "P1",
      "principle": "Script-enforced sponsor bounds are separated from operator/watchtower policy bounds.",
      "required_coverage_tags": [
        "sponsor_policy_boundary"
      ],
      "required_scenarios": [
        "sponsor_fee_pressure",
        "negative_attack_matrix"
      ],
      "required_committed_checks": [
        "manual-sponsor/fund",
        "manual-sponsor/publish"
      ],
      "required_expected_failures": [
        {
          "check": "sponsor-policy-negative-smoke",
          "morph_error": "SponsorStateOutOfRange",
          "error_code": 29
        },
        {
          "check": "sponsor-budget-negative-smoke",
          "morph_error": "SponsorFeeTooHigh",
          "error_code": 17
        }
      ]
    },
    {
      "id": "watchtower_authority_and_cursor",
      "severity": "P2",
      "principle": "Watchtower detection, publication, cursor recovery, and stale-package handling are funding-anchor aware.",
      "required_coverage_tags": [
        "watchtower_authority_and_cursor"
      ],
      "required_scenarios": [
        "watchtower_operations",
        "splice_lifecycle_matrix"
      ],
      "required_committed_checks": [
        "watch-direct-sponsor/watch",
        "watch-config-loop/finalise",
        "watch-splice-stale/apply"
      ],
      "required_expected_failures": []
    },
    {
      "id": "negative_recovery_continuity",
      "severity": "P1",
      "principle": "Expected failures reject exact attack-shaped transactions and later valid transitions still commit.",
      "required_coverage_tags": [
        "negative_recovery_continuity"
      ],
      "required_scenarios": [
        "negative_attack_matrix",
        "bilateral_supersede_watchtower_finalise",
        "sponsor_fee_pressure"
      ],
      "required_committed_checks": [
        "manual-sponsor/finalise",
        "factory/child-finalise",
        "watch-auto-sponsor/finalise"
      ],
      "required_expected_failures": [
        {
          "check": "finalise-since-negative-smoke",
          "morph_error": "StateSinceNotMature",
          "error_code": 16
        },
        {
          "check": "sponsor-policy-negative-smoke",
          "morph_error": "SponsorStateOutOfRange",
          "error_code": 29
        },
        {
          "check": "sponsor-budget-negative-smoke",
          "morph_error": "SponsorFeeTooHigh",
          "error_code": 17
        },
        {
          "check": "xudt-negative-smoke",
          "morph_error": "SettlementOutputMismatch",
          "error_code": 28
        },
        {
          "check": "factory-xudt-negative/smoke",
          "morph_error": "SettlementOutputMismatch",
          "error_code": 28
        },
        {
          "check": "factory-reduced-xudt-negative-exit-smoke",
          "morph_error": "SettlementOutputMismatch",
          "error_code": 28
        }
      ]
    },
    {
      "id": "budget_regression",
      "severity": "P2",
      "principle": "Cycles, transaction bytes, witness lengths, and proof profiles are bounded by a budget gate.",
      "required_coverage_tags": [
        "budget_regression"
      ],
      "required_scenarios": [
        "extreme_state_value_cases",
        "factory_splice_then_exit"
      ],
      "required_committed_checks": [
        "factory-reduced-xudt-splice-out-smoke",
        "factory-reduced-exit-smoke"
      ],
      "required_expected_failures": []
    }
  ]
}
