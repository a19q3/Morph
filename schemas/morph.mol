// Draft Molecule schema for Morph Channel.
//
// The Rust implementation in crates/morph-core currently uses fixed-width
// Rust structs for executable invariant tests. This schema records the intended
// on-chain wire boundary and should be generated once moleculec is available
// in the devnet build environment.
//
// The devnet V1 scripts intentionally use fixed-width encodings. These lengths
// are part of the audited transaction shape:
//
// - StateHeaderV1: 274 bytes
// - StateHeaderV2: 314 bytes
// - SpliceHeaderV1: 325 bytes
// - SpliceSignatureWitnessV1: 198 bytes
// - SpliceVaultAssetAmountV2: 49 bytes
// - SpliceVaultDescriptorV2: 132 bytes
// - SpliceAssetDeltaV1: 113 bytes
// - SpliceAssetDeltasV1: 228 bytes
// - SpliceStateTransitionWitnessV1: 1017 bytes
// - FactoryStateHeaderV1: 238 bytes
// - BilateralSignatureWitnessV1: 198 bytes
// - FactorySignatureWitnessV1: 262 bytes
// - FactoryRightV1: 114 bytes
// - FactoryReducedRightsWitnessV1: 2580 bytes
// - FactoryMerkleUpdateWitnessV1: 8720 bytes
// - FactoryReducedExitWitnessV1: 3058 bytes
// - FactoryReducedExitXudtWitnessV1: 3122 bytes
// - FactoryLocalExitWitnessV1: 726 bytes
// - FactoryLocalExitXudtWitnessV1: 790 bytes
// - FactorySpliceHeaderV1: 275 bytes
// - FactoryVaultDescriptorV1: 132 bytes
// - FactoryVaultDeltaV1: 97 bytes
// - FactoryVaultDeltasV1: 196 bytes
// - FactorySpliceWitnessV1: 999 bytes
// - FactoryReducedSpliceWitnessV1: 9457 bytes
// - BilateralCkbSettlementDescriptorV1: 84 bytes
// - BilateralCkbXudtSettlementDescriptorV1: 148 bytes
// - SponsorPolicyV1: 144 bytes

array Byte32 [byte; 32];
array FactoryMerkleProofSiblingsV1 [Byte32; 256];
array Secp256k1CompressedPubkey [byte; 33];
array EcdsaSignature [byte; 64];

struct OutPointRef {
    tx_hash: Byte32,
    index: uint32,
}

struct ChallengePolicyV1 {
    since_value: uint64,
    detection_depth: uint32,
    min_emergency_rebuilds: uint32,
}

struct StateHeaderV1 {
    protocol_version: uint16,
    chain_id: Byte32,
    signature_scheme_id: uint16,
    channel_id: Byte32,
    funding_anchor: Byte32,
    state_number: uint64,
    mode: byte,
    phase: byte,
    participants_commitment: Byte32,
    asset_registry_commitment: Byte32,
    settlement_descriptor_commitment: Byte32,
    descriptor_version: uint16,
    payload_commitment: Byte32,
    challenge_policy_commitment: Byte32,
    state_layout_version: uint16,
}

// M5 final V1 target. Current devnet scripts still parse StateHeaderV1 while
// the splice bridge is being hardened, but the funding epoch decision is closed:
// the epoch is explicit signed state semantics, not only a value inferred from
// the current vault out point.
struct StateHeaderV2 {
    protocol_version: uint16,
    chain_id: Byte32,
    signature_scheme_id: uint16,
    channel_id: Byte32,
    funding_epoch: uint64,
    funding_anchor: Byte32,
    vault_set_commitment: Byte32,
    state_number: uint64,
    mode: byte,
    phase: byte,
    participants_commitment: Byte32,
    asset_registry_commitment: Byte32,
    settlement_descriptor_commitment: Byte32,
    descriptor_version: uint16,
    payload_commitment: Byte32,
    challenge_policy_commitment: Byte32,
    state_layout_version: uint16,
}

struct SpliceHeaderV1 {
    protocol_version: uint16,
    chain_id: Byte32,
    signature_scheme_id: uint16,
    channel_id: Byte32,
    old_funding_anchor: Byte32,
    new_funding_anchor: Byte32,
    old_funding_epoch: uint64,
    new_funding_epoch: uint64,
    base_state_number: uint64,
    splice_number: uint64,
    kind: byte,
    old_vault_commitment: Byte32,
    new_vault_commitment: Byte32,
    asset_delta_commitment: Byte32,
    participants_commitment: Byte32,
    challenge_policy_commitment: Byte32,
}

struct SpliceSignatureWitnessV1 {
    version: uint16,
    threshold: byte,
    count: byte,
    participant_0_pubkey: Secp256k1CompressedPubkey,
    participant_0_signature: EcdsaSignature,
    participant_1_pubkey: Secp256k1CompressedPubkey,
    participant_1_signature: EcdsaSignature,
}

struct SpliceVaultAssetAmountV2 {
    asset_kind: byte,
    asset_type: Byte32,
    amount: uint128,
}

struct SpliceVaultDescriptorV2 {
    funding_anchor: Byte32,
    asset_count: uint16,
    asset_0: SpliceVaultAssetAmountV2,
    asset_1: SpliceVaultAssetAmountV2,
}

struct SpliceAssetDeltaV1 {
    asset_kind: byte,
    asset_type: Byte32,
    old_amount: uint128,
    new_amount: uint128,
    external_input: uint128,
    withdrawal: uint128,
    signed_fee: uint128,
}

struct SpliceAssetDeltasV1 {
    delta_count: uint16,
    delta_0: SpliceAssetDeltaV1,
    delta_1: SpliceAssetDeltaV1,
}

struct SpliceStateTransitionWitnessV1 {
    version: uint16,
    splice_header: SpliceHeaderV1,
    splice_signature: SpliceSignatureWitnessV1,
    old_vault_descriptor: SpliceVaultDescriptorV2,
    new_vault_descriptor: SpliceVaultDescriptorV2,
    asset_deltas: SpliceAssetDeltasV1,
}

struct FactoryStateHeaderV1 {
    protocol_version: uint16,
    chain_id: Byte32,
    signature_scheme_id: uint16,
    factory_id: Byte32,
    update_number: uint64,
    state_root: Byte32,
    participants_commitment: Byte32,
    access_manifest_root: Byte32,
    non_interference_digest: Byte32,
    challenge_policy_commitment: Byte32,
    state_layout_version: uint16,
}

struct BilateralSignatureWitnessV1 {
    version: uint16,
    threshold: byte,
    count: byte,
    participant_0_pubkey: Secp256k1CompressedPubkey,
    participant_0_signature: EcdsaSignature,
    participant_1_pubkey: Secp256k1CompressedPubkey,
    participant_1_signature: EcdsaSignature,
}

struct FactorySignatureWitnessV1 {
    version: uint16,
    threshold: byte,
    count: byte,
    participant_0_id: Byte32,
    participant_0_pubkey: Secp256k1CompressedPubkey,
    participant_0_signature: EcdsaSignature,
    participant_1_id: Byte32,
    participant_1_pubkey: Secp256k1CompressedPubkey,
    participant_1_signature: EcdsaSignature,
}

struct FactoryRightV1 {
    participant: Byte32,
    subchannel: Byte32,
    kind: byte,
    asset_present: byte,
    asset_type: Byte32,
    quantity: uint128,
}

struct FactoryReducedRightsParticipantV1 {
    participant: Byte32,
    pubkey: Secp256k1CompressedPubkey,
    signed: byte,
    signature: EcdsaSignature,
}

struct FactoryReducedRightsWitnessV1 {
    version: uint16,
    participant_threshold: byte,
    participant_count: byte,
    authorised_count: byte,
    right_count: byte,
    reserved: uint16,
    participant_0: FactoryReducedRightsParticipantV1,
    participant_1: FactoryReducedRightsParticipantV1,
    touched_participant: Byte32,
    before_0: FactoryRightV1,
    before_1: FactoryRightV1,
    before_2: FactoryRightV1,
    before_3: FactoryRightV1,
    before_4: FactoryRightV1,
    before_5: FactoryRightV1,
    before_6: FactoryRightV1,
    before_7: FactoryRightV1,
    before_8: FactoryRightV1,
    before_9: FactoryRightV1,
    after_0: FactoryRightV1,
    after_1: FactoryRightV1,
    after_2: FactoryRightV1,
    after_3: FactoryRightV1,
    after_4: FactoryRightV1,
    after_5: FactoryRightV1,
    after_6: FactoryRightV1,
    after_7: FactoryRightV1,
    after_8: FactoryRightV1,
    after_9: FactoryRightV1,
}

struct FactoryMerkleUpdateWitnessV1 {
    version: uint16,
    participant_threshold: byte,
    participant_count: byte,
    authorised_count: byte,
    right_count: byte,
    reserved: uint16,
    participant_0: FactoryReducedRightsParticipantV1,
    participant_1: FactoryReducedRightsParticipantV1,
    touched_participant: Byte32,
    right_before: FactoryRightV1,
    right_after: FactoryRightV1,
    proof_siblings: FactoryMerkleProofSiblingsV1,
}

struct FactoryReducedExitWitnessV1 {
    version: uint16,
    participant_threshold: byte,
    participant_count: byte,
    authorised_count: byte,
    right_count: byte,
    reserved: uint16,
    participant_0: FactoryReducedRightsParticipantV1,
    participant_1: FactoryReducedRightsParticipantV1,
    touched_participant: Byte32,
    release_quantity: uint128,
    state_output_index: uint32,
    vault_output_index: uint32,
    state_type_hash: Byte32,
    vault_lock_hash: Byte32,
    state_lock_hash: Byte32,
    exit_state_header: StateHeaderV1,
    settlement_descriptor: BilateralCkbSettlementDescriptorV1,
    before_0: FactoryRightV1,
    before_1: FactoryRightV1,
    before_2: FactoryRightV1,
    before_3: FactoryRightV1,
    before_4: FactoryRightV1,
    before_5: FactoryRightV1,
    before_6: FactoryRightV1,
    before_7: FactoryRightV1,
    before_8: FactoryRightV1,
    before_9: FactoryRightV1,
    after_0: FactoryRightV1,
    after_1: FactoryRightV1,
    after_2: FactoryRightV1,
    after_3: FactoryRightV1,
    after_4: FactoryRightV1,
    after_5: FactoryRightV1,
    after_6: FactoryRightV1,
    after_7: FactoryRightV1,
    after_8: FactoryRightV1,
    after_9: FactoryRightV1,
}

struct FactoryReducedExitXudtWitnessV1 {
    version: uint16,
    participant_threshold: byte,
    participant_count: byte,
    authorised_count: byte,
    right_count: byte,
    reserved: uint16,
    participant_0: FactoryReducedRightsParticipantV1,
    participant_1: FactoryReducedRightsParticipantV1,
    touched_participant: Byte32,
    release_quantity: uint128,
    state_output_index: uint32,
    vault_output_index: uint32,
    state_type_hash: Byte32,
    vault_lock_hash: Byte32,
    state_lock_hash: Byte32,
    exit_state_header: StateHeaderV1,
    settlement_descriptor: BilateralCkbXudtSettlementDescriptorV1,
    before_0: FactoryRightV1,
    before_1: FactoryRightV1,
    before_2: FactoryRightV1,
    before_3: FactoryRightV1,
    before_4: FactoryRightV1,
    before_5: FactoryRightV1,
    before_6: FactoryRightV1,
    before_7: FactoryRightV1,
    before_8: FactoryRightV1,
    before_9: FactoryRightV1,
    after_0: FactoryRightV1,
    after_1: FactoryRightV1,
    after_2: FactoryRightV1,
    after_3: FactoryRightV1,
    after_4: FactoryRightV1,
    after_5: FactoryRightV1,
    after_6: FactoryRightV1,
    after_7: FactoryRightV1,
    after_8: FactoryRightV1,
    after_9: FactoryRightV1,
}

struct FactoryLocalExitWitnessV1 {
    version: uint16,
    factory_signature: FactorySignatureWitnessV1,
    state_output_index: uint32,
    vault_output_index: uint32,
    state_type_hash: Byte32,
    vault_lock_hash: Byte32,
    state_lock_hash: Byte32,
    exit_state_header: StateHeaderV1,
    settlement_descriptor: BilateralCkbSettlementDescriptorV1,
}

struct FactoryLocalExitXudtWitnessV1 {
    version: uint16,
    factory_signature: FactorySignatureWitnessV1,
    state_output_index: uint32,
    vault_output_index: uint32,
    state_type_hash: Byte32,
    vault_lock_hash: Byte32,
    state_lock_hash: Byte32,
    exit_state_header: StateHeaderV1,
    settlement_descriptor: BilateralCkbXudtSettlementDescriptorV1,
}

struct FactorySpliceHeaderV1 {
    protocol_version: uint16,
    factory_id: Byte32,
    old_update_number: uint64,
    new_update_number: uint64,
    old_state_root: Byte32,
    new_state_root: Byte32,
    old_access_manifest_root: Byte32,
    new_access_manifest_root: Byte32,
    kind: byte,
    vault_delta_commitment: Byte32,
    non_interference_digest: Byte32,
    participants_commitment: Byte32,
}

struct FactoryVaultAssetAmountV1 {
    asset_kind: byte,
    asset_type: Byte32,
    amount: uint128,
}

struct FactoryVaultDescriptorV1 {
    factory_id: Byte32,
    asset_count: uint16,
    asset_0: FactoryVaultAssetAmountV1,
    asset_1: FactoryVaultAssetAmountV1,
}

struct FactoryVaultDeltaV1 {
    asset_kind: byte,
    asset_type: Byte32,
    old_amount: uint128,
    new_amount: uint128,
    external_input: uint128,
    withdrawal: uint128,
}

struct FactoryVaultDeltasV1 {
    delta_count: uint16,
    delta_0: FactoryVaultDeltaV1,
    delta_1: FactoryVaultDeltaV1,
}

struct FactorySpliceWitnessV1 {
    version: uint16,
    splice_header: FactorySpliceHeaderV1,
    factory_signature: FactorySignatureWitnessV1,
    old_vault_descriptor: FactoryVaultDescriptorV1,
    new_vault_descriptor: FactoryVaultDescriptorV1,
    vault_deltas: FactoryVaultDeltasV1,
}

struct FactoryReducedSpliceWitnessV1 {
    version: uint16,
    splice_header: FactorySpliceHeaderV1,
    merkle_update: FactoryMerkleUpdateWitnessV1,
    old_vault_descriptor: FactoryVaultDescriptorV1,
    new_vault_descriptor: FactoryVaultDescriptorV1,
    vault_deltas: FactoryVaultDeltasV1,
}

struct BilateralCkbSettlementOutputV1 {
    lock_hash: Byte32,
    capacity: uint64,
}

struct BilateralCkbSettlementDescriptorV1 {
    version: uint16,
    output_count: byte,
    reserved: byte,
    output_0: BilateralCkbSettlementOutputV1,
    output_1: BilateralCkbSettlementOutputV1,
}

struct BilateralCkbXudtSettlementOutputV1 {
    lock_hash: Byte32,
    capacity: uint64,
    xudt_amount: uint128,
}

struct BilateralCkbXudtSettlementDescriptorV1 {
    version: uint16,
    output_count: byte,
    asset_count: byte,
    xudt_type_hash: Byte32,
    output_0: BilateralCkbXudtSettlementOutputV1,
    output_1: BilateralCkbXudtSettlementOutputV1,
}

struct SponsorPolicyV1 {
    channel_id: Byte32,
    min_state_number: uint64,
    max_state_number: uint64,
    max_fee_per_tx: uint64,
    max_total_fee: uint64,
    already_spent: uint64,
    expiry: uint64,
    publication_state_type_hash: Byte32,
    change_lock_hash: Byte32,
}
