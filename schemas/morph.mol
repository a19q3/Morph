// Draft Molecule schema for Morph Channel.
//
// The Rust implementation in crates/morph-core currently uses fixed-width
// Rust structs for executable invariant tests. This schema records the intended
// on-chain wire boundary and should be generated once moleculec is available
// in the devnet build environment.
//
// The active devnet channel headers and witness bodies intentionally use
// fixed-width encodings. Factory authorisation witnesses are no longer
// dispatched by raw body length: every factory contract witness is carried in a
// WitnessEnvelope header followed by one bounded body. These lengths are
// part of the audited transaction shape:
//
// - StateHeader: 346 bytes
// - SpliceHeader: 485 bytes
// - SpliceSignatureWitness: 198 bytes
// - SpliceVaultAssetAmount: 49 bytes
// - SpliceVaultDescriptor: 132 bytes
// - SpliceAssetDelta: 113 bytes
// - SpliceAssetDeltas: 228 bytes
// - SpliceStateTransitionWitness: 1177 bytes
// - FactoryStateHeader: 302 bytes
// - BilateralSignatureWitness: 198 bytes
// - FactorySignatureWitness (N=2..16): 4 + N*129 bytes
// - FactoryRight: 114 bytes
// - FactoryReducedRightsWitness: 8 + N*130 + 32 + 20*114 bytes
// - FactoryMerkleUpdateWitness: 8 + N*130 + 32 + 2*114 + 256*32 bytes
// - FactoryReducedExitWitness: participant-dependent; see morph-script-common
// - FactoryLocalExitWitness: participant-dependent; see morph-script-common
// - FactorySpliceHeader: 469 bytes
// - FactoryVaultDescriptor: 132 bytes
// - FactoryVaultDelta: 97 bytes
// - FactoryVaultDeltas: 196 bytes
// - FactorySpliceWitness: participant-dependent; see morph-script-common
// - FactoryReducedSpliceWitness: participant-dependent; see morph-script-common
// The executable length formulas live in morph-script-common and are authoritative.
// - WitnessEnvelope header: 50 bytes
// - BilateralCkbSettlementDescriptor: 84 bytes
// - BilateralCkbXudtSettlementDescriptor: 148 bytes
// - SponsorPolicy: 136 bytes

array Byte32 [byte; 32];
array WitnessEnvelopeMagic [byte; 8];
array FactoryMerkleProofSiblings [Byte32; 256];
array Secp256k1CompressedPubkey [byte; 33];
array EcdsaSignature [byte; 64];

// WitnessEnvelope is a fixed 50-byte prefix followed by a bounded variable
// body. body_commitment is blake2b256(domain, kind_le, body). The current
// factory kind map is:
// 1 FactorySignatureWitness
// 2 FactoryReducedRightsWitness
// 3 FactoryMerkleUpdateWitness
// 4 FactoryReducedExitWitness or FactoryReducedExitXudtWitness
// 5 FactoryLocalExitWitness or FactoryLocalExitXudtWitness
// 6 FactorySpliceWitness
// 7 FactoryReducedSpliceWitness
struct WitnessEnvelope {
    magic: WitnessEnvelopeMagic,
    version: uint16,
    kind: uint16,
    flags: uint16,
    body_len: uint32,
    body_commitment: Byte32,
}

struct OutPointRef {
    tx_hash: Byte32,
    index: uint32,
}

struct ChallengePolicy {
    since_value: uint64,
    detection_depth: uint32,
    min_emergency_rebuilds: uint32,
}

struct StateHeader {
    protocol_version: uint16,
    chain_id: Byte32,
    signature_scheme_id: uint16,
    channel_id: Byte32,
    funding_epoch: uint64,
    funding_anchor: Byte32,
    vault_set_commitment: Byte32,
    state_number: uint64,
    mode: byte,
    phase: byte,
    participants_commitment: Byte32,
    asset_registry_commitment: Byte32,
    settlement_descriptor_commitment: Byte32,
    descriptor_version: uint16,
    vault_materialisation_root: Byte32,
    challenge_policy_commitment: Byte32,
    state_layout_version: uint16,
    vault_outpoint_commitment: Byte32,
}

struct SpliceHeader {
    protocol_version: uint16,
    chain_id: Byte32,
    signature_scheme_id: uint16,
    channel_id: Byte32,
    old_funding_anchor: Byte32,
    new_funding_anchor: Byte32,
    old_funding_epoch: uint64,
    new_funding_epoch: uint64,
    base_state_number: uint64,
    splice_number: uint64,
    kind: byte,
    old_vault_commitment: Byte32,
    new_vault_commitment: Byte32,
    asset_delta_commitment: Byte32,
    participants_commitment: Byte32,
    vault_materialisation_root: Byte32,
    new_vault_materialisation_root: Byte32,
    challenge_policy_commitment: Byte32,
    old_vault_outpoint_commitment: Byte32,
    new_vault_outpoint_commitment: Byte32,
    withdrawal_lock_hash: Byte32,
}

struct SpliceSignatureWitness {
    version: uint16,
    threshold: byte,
    count: byte,
    participant_0_pubkey: Secp256k1CompressedPubkey,
    participant_0_signature: EcdsaSignature,
    participant_1_pubkey: Secp256k1CompressedPubkey,
    participant_1_signature: EcdsaSignature,
}

struct SpliceVaultAssetAmount {
    asset_kind: byte,
    asset_type: Byte32,
    amount: uint128,
}

struct SpliceVaultDescriptor {
    funding_anchor: Byte32,
    asset_count: uint16,
    asset_0: SpliceVaultAssetAmount,
    asset_1: SpliceVaultAssetAmount,
}

struct SpliceAssetDelta {
    asset_kind: byte,
    asset_type: Byte32,
    old_amount: uint128,
    new_amount: uint128,
    external_input: uint128,
    withdrawal: uint128,
    signed_fee: uint128,
}

struct SpliceAssetDeltas {
    delta_count: uint16,
    delta_0: SpliceAssetDelta,
    delta_1: SpliceAssetDelta,
}

struct SpliceStateTransitionWitness {
    version: uint16,
    splice_header: SpliceHeader,
    splice_signature: SpliceSignatureWitness,
    old_vault_descriptor: SpliceVaultDescriptor,
    new_vault_descriptor: SpliceVaultDescriptor,
    asset_deltas: SpliceAssetDeltas,
}

struct FactoryStateHeader {
    protocol_version: uint16,
    chain_id: Byte32,
    signature_scheme_id: uint16,
    factory_id: Byte32,
    update_number: uint64,
    state_root: Byte32,
    participants_commitment: Byte32,
    access_manifest_root: Byte32,
    non_interference_digest: Byte32,
    challenge_policy_commitment: Byte32,
    state_layout_version: uint16,
    vault_materialisation_root: Byte32,
    vault_outpoint_commitment: Byte32,
}

struct BilateralSignatureWitness {
    version: uint16,
    threshold: byte,
    count: byte,
    participant_0_pubkey: Secp256k1CompressedPubkey,
    participant_0_signature: EcdsaSignature,
    participant_1_pubkey: Secp256k1CompressedPubkey,
    participant_1_signature: EcdsaSignature,
}


struct FactoryRight {
    participant: Byte32,
    subchannel: Byte32,
    kind: byte,
    asset_present: byte,
    asset_type: Byte32,
    quantity: uint128,
}

struct FactoryReducedRightsParticipant {
    participant: Byte32,
    pubkey: Secp256k1CompressedPubkey,
    signed: byte,
    signature: EcdsaSignature,
}




struct FactoryReducedExitXudtWitness {
    version: uint16,
    participant_threshold: byte,
    participant_count: byte,
    authorised_count: byte,
    right_count: byte,
    reserved: uint16,
    participant_0: FactoryReducedRightsParticipant,
    participant_1: FactoryReducedRightsParticipant,
    touched_participant: Byte32,
    release_quantity: uint128,
    state_output_index: uint32,
    vault_output_index: uint32,
    state_type_hash: Byte32,
    vault_lock_hash: Byte32,
    state_lock_hash: Byte32,
    exit_state_header: StateHeader,
    settlement_descriptor: BilateralCkbXudtSettlementDescriptor,
    before_0: FactoryRight,
    before_1: FactoryRight,
    before_2: FactoryRight,
    before_3: FactoryRight,
    before_4: FactoryRight,
    before_5: FactoryRight,
    before_6: FactoryRight,
    before_7: FactoryRight,
    before_8: FactoryRight,
    before_9: FactoryRight,
    before_10: FactoryRight,
    before_11: FactoryRight,
    after_0: FactoryRight,
    after_1: FactoryRight,
    after_2: FactoryRight,
    after_3: FactoryRight,
    after_4: FactoryRight,
    after_5: FactoryRight,
    after_6: FactoryRight,
    after_7: FactoryRight,
    after_8: FactoryRight,
    after_9: FactoryRight,
    after_10: FactoryRight,
    after_11: FactoryRight,
}



struct FactorySpliceHeader {
    protocol_version: uint16,
    chain_id: Byte32,
    signature_scheme_id: uint16,
    factory_id: Byte32,
    old_update_number: uint64,
    new_update_number: uint64,
    old_state_root: Byte32,
    new_state_root: Byte32,
    old_access_manifest_root: Byte32,
    new_access_manifest_root: Byte32,
    kind: byte,
    vault_delta_commitment: Byte32,
    non_interference_digest: Byte32,
    participants_commitment: Byte32,
    old_vault_materialisation_root: Byte32,
    new_vault_materialisation_root: Byte32,
    old_vault_outpoint_commitment: Byte32,
    new_vault_outpoint_commitment: Byte32,
    withdrawal_lock_hash: Byte32,
}

struct FactoryVaultAssetAmount {
    asset_kind: byte,
    asset_type: Byte32,
    amount: uint128,
}

struct FactoryVaultDescriptor {
    factory_id: Byte32,
    asset_count: uint16,
    asset_0: FactoryVaultAssetAmount,
    asset_1: FactoryVaultAssetAmount,
}

struct FactoryVaultDelta {
    asset_kind: byte,
    asset_type: Byte32,
    old_amount: uint128,
    new_amount: uint128,
    external_input: uint128,
    withdrawal: uint128,
}

struct FactoryVaultDeltas {
    delta_count: uint16,
    delta_0: FactoryVaultDelta,
    delta_1: FactoryVaultDelta,
}



struct BilateralCkbSettlementOutput {
    lock_hash: Byte32,
    capacity: uint64,
}

struct BilateralCkbSettlementDescriptor {
    version: uint16,
    output_count: byte,
    reserved: byte,
    output_0: BilateralCkbSettlementOutput,
    output_1: BilateralCkbSettlementOutput,
}

struct BilateralCkbXudtSettlementOutput {
    lock_hash: Byte32,
    capacity: uint64,
    xudt_amount: uint128,
}

struct BilateralCkbXudtSettlementDescriptor {
    version: uint16,
    output_count: byte,
    asset_count: byte,
    xudt_type_hash: Byte32,
    output_0: BilateralCkbXudtSettlementOutput,
    output_1: BilateralCkbXudtSettlementOutput,
}

struct SponsorPolicy {
    channel_id: Byte32,
    min_state_number: uint64,
    max_state_number: uint64,
    max_fee_per_tx: uint64,
    max_total_fee: uint64,
    already_spent: uint64,
    publication_state_type_hash: Byte32,
    change_lock_hash: Byte32,
}
